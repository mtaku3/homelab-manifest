{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "helm-values": {
    "description": "Also the <name>-values.yaml and values-<name>.yaml files passed to helmCharts; the default pattern only matches values.yaml.",
    "managerFilePatterns": ["/(^|/)values\\.ya?ml$/", "/^dev/.+[-.]values\\.ya?ml$/", "/^dev/.+/values-[^/]+\\.ya?ml$/"]
  },
  "kubernetes": {
    "description": "Plain manifests under dev/. The kubernetes manager has no default file patterns, so their images were never checked.",
    "managerFilePatterns": ["/^dev/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/.*y[a]?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+- https://\\S+/releases/download/(?<currentValue>[^/\\s]+)/"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/.*y[a]?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+tag:\\s+(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "{{datasource}}",
      "depNameTemplate": "{{depName}}",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["loxilb-io/loxilb"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$"
    },
    {
      "description": "GitLab is an archive until its repositories move elsewhere. Chart 10 (GitLab 19) drops the bundled PostgreSQL, Redis and MinIO it runs on, so stay on 9.x and keep taking its patch releases.",
      "matchManagers": ["kustomize"],
      "matchDepNames": ["gitlab"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "vmagent, vmalert and vmsingle are pinned to the same VictoriaMetrics release in values-k8s-stack.yaml.",
      "matchPackageNames": ["victoriametrics/vmagent", "victoriametrics/vmalert", "victoriametrics/victoria-metrics"],
      "groupName": "victoriametrics"
    }
  ]
}
